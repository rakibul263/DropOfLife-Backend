# ==============================================================================
# DropOfLife (জীবনের এক ফোঁটা) — Backend Environment Configuration
# ==============================================================================

# Server & Client Ports
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Neon Database (Serverless PostgreSQL)
# Get from: https://console.neon.tech/app/projects -> Connection Details
# Select "Prisma" or "PostgreSQL" and copy the pooled connection string
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/dropoflife?sslmode=require"

# Fallback MongoDB URI (Optional)
MONGODB_URI=mongodb+srv://username:password@cluster0.demo.mongodb.net/dropoflife?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Arcjet Security (Bot Protection, Attack Shield & Rate Limiting)
# Get from: https://launch.arcjet.com or https://app.arcjet.com
# Create a site and copy the Site SDK key (starts with "ajkey_")
# ------------------------------------------------------------------------------
ARCJET_KEY=ajkey_your_arcjet_site_key_here
ARCJET_ENV=development

# ------------------------------------------------------------------------------
# 3. Resend Email Service (Transactional Welcome & Donor Alerts)
# Get from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="DropOfLife <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. JWT Authentication Secrets
# Generate random 32+ character strings for production
# ------------------------------------------------------------------------------
JWT_SECRET=dropoflife_super_secure_jwt_secret_key_2026_lifesaver
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dropoflife_refresh_super_secret_jwt_key_2026_lifesaver
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 5. National Emergency Blood Dispatch Hotline
# ------------------------------------------------------------------------------
EMERGENCY_HOTLINE=+8801521711716

# ------------------------------------------------------------------------------
# 6. Stripe Payment Gateway (Optional for Lifesaver Fund donations)
# Get from: https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForDemoEvaluation999888777
STRIPE_WEBHOOK_SECRET=whsec_mockWebhookSecret2026
