# ── Application Environment ─────────────────────────────────────────────
PORT=5050
NODE_ENV=production
CLIENT_URL=https://dropoflife.vercel.app
ALLOWED_ORIGINS=https://dropoflife.vercel.app,http://localhost:3000

# ── Neon Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.aws.neon.tech/neondb?sslmode=require"

# ── JWT Authentication ──────────────────────────────────────────────────
